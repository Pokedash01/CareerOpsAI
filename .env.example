# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional bot token to dispatch high-match job notifications
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Optional default Telegram Chat ID for notifications
TELEGRAM_CHAT_ID=""

# SERPAPI_KEY: Optional key for Google Jobs / ATS live searches
SERPAPI_KEY=""

# EMAIL DISPATCH (Optional: SMTP / Resend / SendGrid for real email delivery)
# If left empty, a secure test account/local logger is used automatically
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="CareerOps Security <security@careerops.ai>"
# Or use RESEND_API_KEY="" / SENDGRID_API_KEY=""
