{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/telegram/notify",
      "destination": "/api/telegram/notify"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
